[mysqld]
port=3306
event_scheduler=1
mysql_native_password=ON
default_time_zone="-03:00"
tmpdir=/tmp
datadir=/var/lib/mysql/
replica_load_tmpdir=/tmp
socket=/var/run/mysqld/mysqld.sock

# * Basic Settings
mysqlx=0
local-infile=0
disable-log-bin=1
max_connections=100
skip-name-resolve=1
performance-schema=0
open_files_limit=200000
max_allowed_packet=128M

# Default
sql_mode=''
back_log=1500
local_infile=0
tmp_table_size=128M
table_open_cache=2000
thread_stack=256K #64bits
thread_cache_size=256
table_definition_cache=2000

# Config Timeout
#wait_timeout=60
#connect_timeout=5
#interactive_timeout=30

# Tunning Buffer
read_buffer_size=256K
join_buffer_size=512K
sort_buffer_size=512K
read_rnd_buffer_size=512K
max_heap_table_size=128M

# Config General Log
general_log=0
log_output=FILE
general_log_file=/var/lib/mysql/mysqld-general.log

[mysqld_safe]
expire_logs_days=3
max_binlog_size=10M
log-error=/var/log/mysqld.log

# SLOW QUERY
slow_query_log=0
long_query_time=10
slow_queries_log_file=/var/lib/mysql/mysql-slowq.log
log_queries_not_using_indexes=1

[mysqldump]
quick
quote-names
max_allowed_packet=128M
